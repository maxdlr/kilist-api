# Backend server
NODE_ENV=production
BACK_PORT=8080
LOG_LEVEL=info

# CORS - comma-separated list of allowed origins
CORS_ORIGIN_URL=https://your-frontend-domain.example.com

# Database (MariaDB/MySQL)
DB_HOST=kilist-db
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
APP_NAME=kilist

# Auth
COOKIE_SECRET=changeme
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# Seed fixtures - required at startup, sets the password for fixture admin user
ADMIN_PASSWORD=changeme
