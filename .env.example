# Backend server
NODE_ENV=production
BACK_PORT=8080
LOG_LEVEL=info
# Number of reverse proxies in front of the API (1 for a single Nginx Proxy Manager).
# Without it, rate limits count every visitor as the proxy's single address.
TRUST_PROXY=1

# CORS - comma-separated list of allowed origins
CORS_ORIGIN_URL=https://your-frontend-domain.example.com

# Database (MariaDB/MySQL)
DB_HOST=kilist-db
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
APP_NAME=kilist
# Set to "true" to auto-create/update the schema from entities on boot.
# Convenient for a throwaway beta with no migrations. Leave unset/false once
# real migrations exist, as synchronize can drop/alter columns on entity changes.
DB_SYNC=true

# Auth
COOKIE_SECRET=changeme
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# Google sign-in: the "Web application" OAuth client ID (comma-separated if several). Empty turns it off.
GOOGLE_CLIENT_IDS=


# Required at startup: the admin account's password
ADMIN_PASSWORD=changeme

# Email - nothing is sent until the SMTP values and EMAIL_FROM are all set
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Kilist <hello@your-domain.example.com>
# Shown in emails as the address to contact. Defaults to EMAIL_FROM
EMAIL_SUPPORT=
# Where email buttons lead. Buttons are left out when empty
EMAIL_APP_URL=
